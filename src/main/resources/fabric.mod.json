{
  "schemaVersion": 1,
  "id": "bingzhengmod",
  "version": "${version}",
  "name": "病证",
  "description": "以中医理法贯穿生存全程的 Minecraft 模组。核心包《病证》为全部 23 个拓展的基座。",
  "authors": [
    "Botzhanshen"
  ],
  "contact": { "homepage": "https://github.com/Botzhanshen/bingzheng", "sources": "https://github.com/Botzhanshen/bingzheng" },
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.bingzheng.BingzhengMod",
      "com.bingzheng.emotion.EmotionInitializer",
      "com.bingzheng.wuzang.WuzangInitializer",
      "com.bingzheng.selfcheck.CommandSelfCheck"
    ],
    "client": [
      "com.bingzheng.client.BingzhengModClient",
      "com.bingzheng.emotion.client.EmotionClientInitializer"
    ]
  },
  "mixins": [
    "bingzhengmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {}
}
